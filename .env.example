# Frontend Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# API Configuration
VITE_API_URL=http://localhost:4000
VITE_ENVIRONMENT=development
VITE_ENABLE_SPELL_API=false
# VITE_SPELL_API_URL=http://localhost:8888

# Marketing site + SEO configuration
SITE_URL=https://infinite-realms.ai

# Development Test Account (for development only)
VITE_DEV_TEST_EMAIL=test@example.com
VITE_DEV_TEST_PASSWORD=testpass123

# Required for seeding test data (get from Supabase Project Settings > API)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI Service Keys - Gemini API key (can add multiple comma-separated for rotation)
VITE_GEMINI_API_KEYS=your_gemini_api_key_here

# Single key for Edge Functions (Supabase environment)
VITE_GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional additional AI services
# VITE_OPENAI_API_KEY=your_openai_key_here
VITE_ELEVENLABS_API_KEY=your_elevenlabs_key_here

# OpenRouter API for image generation (Gemini 2.5 Flash Image)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Safety system toggle (defaults to false; enable only if you want in-app safety guardrails)
VITE_ENABLE_SAFETY_GUARDS=false

# Optional subsystems (disabled by default)
VITE_ENABLE_SEMANTIC_MEMORIES=false
VITE_ENABLE_WORLD_BUILDER=false

# LangGraph Migration Flags (Phase 3 - Component Migration)
# Phase 1 - Development Testing: USE_LANGGRAPH=true, USE_LEGACY_AGENTS=true, HYBRID_MODE=true
# Phase 2 - Production Canary: USE_LANGGRAPH=true, USE_LEGACY_AGENTS=true, HYBRID_MODE=false
# Phase 3 - Full Migration: USE_LANGGRAPH=true, USE_LEGACY_AGENTS=false, HYBRID_MODE=false
VITE_USE_LANGGRAPH=false
VITE_USE_LEGACY_AGENTS=true
VITE_HYBRID_MODE=false

# Combat settings
VITE_ENABLE_COMBAT_DM_NARRATION=false
VITE_COMBAT_SHEET_OVERLAY=dark

# Blog / Marketing Site
SITE_URL=http://localhost:3000
BLOG_MEDIA_BUCKET=blog-media
