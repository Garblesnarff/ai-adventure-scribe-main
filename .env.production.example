# ============================================
# AI Adventure Scribe - Production Environment
# ============================================

# ==========================================
# Supabase Configuration
# ==========================================

# PostgreSQL Database Password
# SECURITY: Generate a strong password (32+ characters)
POSTGRES_PASSWORD=your-super-secure-postgres-password-here

# JWT Secret for Supabase Auth
# SECURITY: Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Supabase Anon Key (Public)
# SECURITY: Generate with Supabase CLI or use a JWT with role: anon
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxvY2FsIiwicm9sZSI6ImFub24iLCJpYXQiOjE2NzcxNTY4MDAsImV4cCI6MTk5MjcxNjgwMH0.your-anon-key-here

# Supabase Service Key (Private - Backend Only)
# SECURITY: Generate with Supabase CLI or use a JWT with role: service_role
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxvY2FsIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTY3NzE1NjgwMCwiZXhwIjoxOTkyNzE2ODAwfQ.your-service-key-here

# Realtime Secret Key Base
# SECURITY: Generate with: openssl rand -base64 32
REALTIME_SECRET_KEY_BASE=your-realtime-secret-key-base-here

# ==========================================
# Public URLs
# ==========================================

# API External URL (Kong gateway endpoint)
# Replace with your Hetzner VPS domain or IP
API_EXTERNAL_URL=http://your-domain.com:8001

# Site URL (Frontend)
# Replace with your Hetzner VPS domain or IP
SITE_URL=http://your-domain.com:3000

# Additional Redirect URLs (comma-separated)
# Add any additional domains for OAuth redirects
ADDITIONAL_REDIRECT_URLS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# SMTP Configuration (Email)
# ==========================================
# Required for user authentication emails

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_ADMIN_EMAIL=admin@example.com

# ==========================================
# AI Service API Keys
# ==========================================

# OpenRouter API Key (for CrewAI)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Anthropic API Key (optional, for direct Claude access)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API Key (optional)
OPENAI_API_KEY=your-openai-api-key-here

# ==========================================
# WorkOS Configuration (Future Migration)
# ==========================================
# NOTE: Not yet active - for future auth migration from Supabase GoTrue

WORKOS_CLIENT_ID=your-workos-client-id-here
WORKOS_API_KEY=your-workos-api-key-here
WORKOS_REDIRECT_URI=http://your-domain.com:3000/auth/callback

# ==========================================
# Application Settings
# ==========================================

NODE_ENV=production
LOG_LEVEL=info

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_ERROR_REPORTING=false
