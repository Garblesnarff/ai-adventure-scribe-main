# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173
APP_ORIGIN=http://localhost:5173
SITE_URL=http://localhost:5173
BLOG_MEDIA_BUCKET=blog-media

# Database
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/ai_adventure_scribe
PGSSL=false
PGPOOL_MAX=10

# Auth
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# AI Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# OpenRouter (server-side only)
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# For tests only
STRIPE_WEBHOOK_SKIP_VERIFY=true
