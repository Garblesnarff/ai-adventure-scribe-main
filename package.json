{
  "name": "infinite-realms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:crewai\"",
    "dev:frontend": "vite",
    "dev:backend": "npm run server:dev",
    "dev:crewai": "uvicorn main:app --reload --port 8000 --app-dir crewai-service",
    "dev:full": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:database\"",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "server:dev": "npm run server:build && npm run server:start",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "PORT=8888 node server/dist/index.js",
    "server:migrate": "ts-node --project server/tsconfig.json server/src/scripts/migrate.ts",
    "server:seed": "ts-node --project server/tsconfig.json server/src/scripts/seed.ts",
    "server:seed-comprehensive": "ts-node --project server/tsconfig.json server/src/scripts/comprehensive-seed.ts",
    "server:seed-bard-spells": "ts-node --project server/tsconfig.json server/src/scripts/seed-bard-spells.ts",
    "server:seed-bard-spells-supabase": "ts-node --project server/tsconfig.json server/src/scripts/seed-bard-spells-supabase.ts",
    "server:migrate-all": "ts-node --project server/tsconfig.json server/src/scripts/run-all-migrations.ts",
    "server:test": "vitest run --dir server",
    "seed:test-data": "node scripts/seed-test-data.js",
    "install:all": "npm install && cd server && npm install",
    "mvp:setup": "echo 'Setting up MVP...' && npm install && echo 'Next: Copy .env.example to .env.local and configure your Supabase credentials'",
    "mvp:build": "npm run lint && npm run build",
    "check-deps": "npx depcheck || true",
    "check-unused-exports": "npx ts-prune --paths ./tsconfig.json || true",
    "check-dead": "npm run check-deps && npm run check-unused-exports"
  },
  "dependencies": {
    "@11labs/react": "^0.0.4",
    "@anthropic-ai/sdk": "^0.32.0",
    "@dice-roller/rpg-dice-roller": "^5.5.1",
    "@fontsource/medievalsharp": "^5.1.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^3.9.0",
